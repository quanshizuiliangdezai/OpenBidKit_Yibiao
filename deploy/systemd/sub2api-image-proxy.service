[Unit]
Description=sub2api -> agnes image rename proxy
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/sub2api-image-proxy/proxy.py
Restart=always
RestartSec=3
User=root
WorkingDirectory=/opt/sub2api-image-proxy
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
